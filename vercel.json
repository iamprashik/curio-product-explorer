{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/catalogue",
      "destination": "/api?__curio_route=catalogue"
    },
    { "source": "/api/products", "destination": "/api?__curio_route=products" },
    {
      "source": "/api/products/:id",
      "destination": "/api?__curio_route=product&__curio_id=:id"
    },
    { "source": "/api/:path*", "destination": "/api?__curio_route=missing" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
